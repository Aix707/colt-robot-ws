<launch>
  <arg name="runtime_dir" default="$(find colt_bridle)/models/runtime/current"/>
  <arg name="target_frame" default="map"/>
  <arg name="robot_frame" default="body_link"/>
  <arg name="detection_rate_hz" default="2.0"/>
  <arg name="start_pt_control" default="false"/>
  <arg name="selected_reacquire_distance_m" default="0.6"/>
  <arg name="selected_reacquire_margin_m" default="0.30"/>
  <arg name="selected_reacquire_iou" default="0.01"/>
  <arg name="chair_smooth_alpha" default="0.35"/>
  <arg name="chair_jump_reject_m" default="0.6"/>

  <arg name="color_topic" default="/kinect2/qhd/image_color_rect"/>
  <arg name="depth_topic" default="/kinect2/qhd/image_depth_rect"/>
  <arg name="camera_info_topic" default="/kinect2/qhd/camera_info"/>
  <arg name="joint_states_topic" default="/joint_states"/>
  <arg name="source_topic" default="/colt/ui/selected_source_chair"/>
  <arg name="target_topic" default="/colt/ui/selected_target_chair"/>
  <arg name="pt_state_topic" default="/colt/ui/pt_state"/>
  <arg name="wp_tilt_min_deg" default="-20.0"/>
  <arg name="wp_tilt_max_deg" default="20.0"/>
  <arg name="wp_pitch_min_deg" default="0.0"/>
  <arg name="wp_pitch_max_deg" default="30.0"/>
  <arg name="scan_step_deg" default="1.0"/>
  <arg name="scan_pitch_step_deg" default="1.0"/>
  <arg name="detection_timeout_sec" default="2.0"/>
  <arg name="track_pitch" default="true"/>
  <arg name="local_search_hold_sec" default="0.8"/>
  <arg name="local_search_sec" default="4.0"/>
  <arg name="local_search_tilt_deg" default="8.0"/>
  <arg name="local_search_pitch_deg" default="5.0"/>

  <node pkg="colt_bridle" type="detector_node.py" name="colt_detector" output="screen">
    <env name="PYTHONPATH" value="$(find colt_bridle)/scripts:$(find colt_bridle)/../../../devel/lib/python3/dist-packages:/opt/ros/noetic/lib/python3/dist-packages:$(optenv PYTHONPATH)"/>
    <param name="runtime_dir" value="$(arg runtime_dir)"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="detection_rate_hz" value="$(arg detection_rate_hz)"/>
    <param name="selected_reacquire_distance_m" value="$(arg selected_reacquire_distance_m)"/>
    <param name="selected_reacquire_margin_m" value="$(arg selected_reacquire_margin_m)"/>
    <param name="selected_reacquire_iou" value="$(arg selected_reacquire_iou)"/>
    <param name="chair_smooth_alpha" value="$(arg chair_smooth_alpha)"/>
    <param name="chair_jump_reject_m" value="$(arg chair_jump_reject_m)"/>
    <param name="color_topic" value="$(arg color_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
  </node>

  <node if="$(arg start_pt_control)" pkg="colt_bridle" type="pt_control_node.py" name="colt_pt_control" output="screen">
    <env name="PYTHONPATH" value="$(find colt_bridle)/scripts:$(find colt_bridle)/../../../devel/lib/python3/dist-packages:/opt/ros/noetic/lib/python3/dist-packages:$(optenv PYTHONPATH)"/>
    <param name="detections_topic" value="/colt/bridle/detections"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="joint_states_topic" value="$(arg joint_states_topic)"/>
    <param name="source_topic" value="$(arg source_topic)"/>
    <param name="target_topic" value="$(arg target_topic)"/>
    <param name="pt_state_topic" value="$(arg pt_state_topic)"/>
    <param name="wp_tilt_min_deg" value="$(arg wp_tilt_min_deg)"/>
    <param name="wp_tilt_max_deg" value="$(arg wp_tilt_max_deg)"/>
    <param name="wp_pitch_min_deg" value="$(arg wp_pitch_min_deg)"/>
    <param name="wp_pitch_max_deg" value="$(arg wp_pitch_max_deg)"/>
    <param name="scan_step_deg" value="$(arg scan_step_deg)"/>
    <param name="scan_pitch_step_deg" value="$(arg scan_pitch_step_deg)"/>
    <param name="detection_timeout_sec" value="$(arg detection_timeout_sec)"/>
    <param name="track_pitch" value="$(arg track_pitch)"/>
    <param name="local_search_hold_sec" value="$(arg local_search_hold_sec)"/>
    <param name="local_search_sec" value="$(arg local_search_sec)"/>
    <param name="local_search_tilt_deg" value="$(arg local_search_tilt_deg)"/>
    <param name="local_search_pitch_deg" value="$(arg local_search_pitch_deg)"/>
  </node>
</launch>
